# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — SERVER ONLY, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Admin Gate — a separate username/password lock in front of /admin,
# independent of regular customer/agent/builder accounts. Choose your own
# values. ADMIN_GATE_TOKEN should be a long random string (e.g. generate
# one at https://generate-secret.vercel.app/32) — it's never shown to
# anyone, it's just the server's internal session marker.
ADMIN_GATE_USERNAME=
ADMIN_GATE_PASSWORD=
ADMIN_GATE_TOKEN=
